{
  "name": "relab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "vite build && wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply relab --local",
    "db:migrate": "wrangler d1 migrations apply relab --remote",
    "deploy": "vite build && wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
